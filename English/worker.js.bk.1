// worker.js
var worker_default = {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // ==========================================
    // 新增：发送邮件报告的 API 接口 (已更换为 EmailJS)
    // ==========================================
    if (url.pathname === "/api/send-email" && request.method === "POST") {
      try {
        const data = await request.json();
        // 接收前端传来的结构化日志数组 logs
        const { profile, score, total, logs } = data;

        // ⚠ EmailJS 必需配置区域
        const serviceID = 'service_j2ak28v';   // 你的 Service ID
        const templateID = 'template_ol3ws9o'; // 你的 Template ID
        const publicKey = 'bGbqCw1wlTrkCwfFo';   // 你的 Public Key
        const privateKey = 'DZc0GWCYIN_tMdOsQ27AM'; // ⚠ 你的 Private Key (在 Account -> API Keys 中获取)

        // 获取当前时间，格式化为中国时区
        const currentTime = new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });

        // --- 核心优化：按要求重新组装邮件文本 ---
        const correctLogs = logs.filter(l => l.isCorrect);
        const incorrectLogs = logs.filter(l => !l.isCorrect);

        let reportMessage = `亲爱的家长/老师：\n`;
        reportMessage += `学习者 ${profile} 刚刚完成了识字/错题打卡！\n`;
        reportMessage += `⏰ 时间：${currentTime}\n`;
        reportMessage += `🏆 最终得分： ${score} / ${total} 分\n\n`;

        reportMessage += `📚 今天学习的所有内容：\n`;
        logs.forEach((log, index) => {
            reportMessage += `${index + 1}. [${log.tag}] 原句：${log.context}\n   (错：${log.incorrect} ➔ 正：${log.correct})\n`;
        });

        reportMessage += `\n✅ 已经完全掌握（一次全对）：\n`;
        if (correctLogs.length > 0) {
            correctLogs.forEach(log => {
                reportMessage += ` - ${log.correct} (考点: ${log.tag})\n`;
            });
        } else {
            reportMessage += ` - 无\n`;
        }

        reportMessage += `\n⚠️ 尚未完全掌握（需要复习）：\n`;
        if (incorrectLogs.length > 0) {
            incorrectLogs.forEach(log => {
                reportMessage += ` - 误用: ${log.incorrect} ➔ 正确: ${log.correct}\n   (原句: ${log.context})\n`;
            });
        } else {
            reportMessage += ` - 无\n`;
        }
        // ----------------------------------------

        // 使用 EmailJS REST API 发送邮件 (Cloudflare Worker 后端调用方式)
        const emailRes = await fetch("https://api.emailjs.com/api/v1.0/email/send", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            service_id: serviceID,
            template_id: templateID,
            user_id: publicKey,
            accessToken: privateKey, // 严格模式下必需的私钥验证
            template_params: {
              title: `打卡报告：${profile} 错题挑战完成`,
              name: profile,
              time: currentTime,
              message: reportMessage // 将拼装好的富文本赋给 message 变量
            }
          })
        });

        // EmailJS 成功通常返回文本 "OK"，而不是 JSON
        const responseText = await emailRes.text();
        
        // 优化错误捕获，将 EmailJS 原始报错直接返回给前端
        if (!emailRes.ok) {
          return new Response(JSON.stringify({ success: false, error: responseText }), {
            headers: { "Content-Type": "application/json" }
          });
        }

        return new Response(JSON.stringify({ success: true, message: responseText }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (e) {
        return new Response(JSON.stringify({ success: false, error: e.message }), { 
          headers: { "Content-Type": "application/json" }
        });
      }
    }

    if (url.pathname === "/api/memory/get" && request.method === "GET") {
      const userProfile = url.searchParams.get("userProfile");
      if (!userProfile) return new Response("Missing userProfile", { status: 400 });
      try {
        const { results } = await env.DB.prepare(
          "SELECT * FROM ebbinghaus_records WHERE user_profile = ? ORDER BY next_review_time ASC"
        ).bind(userProfile).all();
        const formattedResults = results.map((row) => ({
          id: row.id,
          questionId: row.question_id,
          level: row.level,
          nextReviewTime: row.next_review_time
        }));
        return new Response(JSON.stringify(formattedResults), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (e) {
        return new Response(JSON.stringify({ error: e.message }), { status: 500 });
      }
    }
    if (url.pathname === "/api/memory/upsert" && request.method === "POST") {
      try {
        const data = await request.json();
        const { userProfile, questionId, level, nextReviewTime } = data;
        const id = userProfile + "_" + questionId;
        const now = Date.now();
        await env.DB.prepare(`
          INSERT INTO ebbinghaus_records (id, user_profile, question_id, level, next_review_time, last_updated)
          VALUES (?1, ?2, ?3, ?4, ?5, ?6)
          ON CONFLICT(id) DO UPDATE SET 
          level = excluded.level, 
          next_review_time = excluded.next_review_time, 
          last_updated = excluded.last_updated
        `).bind(id, userProfile, questionId, level, nextReviewTime, now).run();
        return new Response(JSON.stringify({ success: true }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (e) {
        return new Response(JSON.stringify({ error: e.message }), { status: 500 });
      }
    }
    if (url.pathname === "/api/memory/clear" && request.method === "POST") {
      try {
        const data = await request.json();
        const { userProfile } = data;
        await env.DB.prepare("DELETE FROM ebbinghaus_records WHERE user_profile = ?").bind(userProfile).run();
        return new Response(JSON.stringify({ success: true }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (e) {
        return new Response(JSON.stringify({ error: e.message }), { status: 500 });
      }
    }
    return new Response(HTML_CONTENT, {
      headers: { "Content-Type": "text/html;charset=UTF-8" }
    });
  }
};
